# =========================================================================
# Konclude reasoner - Git ignore rules
# -------------------------------------------------------------------------
# Note: Prebuilt third-party libraries under External/ (e.g. librdf, hoard)
# are intentionally committed to the repository, including their
# release/debug output folders (External/**/lib/Release/*.lib etc.).
# All build-artifact patterns below are therefore anchored to the
# repository root so files under External/ are never affected.
# =========================================================================

# ---------- Konclude / qmake build outputs -----------------------------
# Object files produced by qmake (OBJECTS_DIR = release/)
/release/
# Binary output produced by qmake (DESTDIR = ./Release) and by the
# Visual Studio 2015 project for the Win32 "Release" configuration.
/Release/
# Debug variants of the above.
/debug/
/Debug/
# Output of the Visual Studio 2015 project for x64 configurations
# (OutDir = x64\$(Configuration)\VS2015\).
/x64/
# Qt-generated files (moc, uic, rcc) produced by qmake and the
# Visual Studio Qt plugin.
/GeneratedFiles/
/generatedfiles/

# ---------- Logs ---------------------------------------------------------
# Local build, test and conformance logs.
/logs/
# Local debug data dumps (./Debugging from -c Configs/debugging-config.xml runs).
/Debugging/
*.log

# ---------- qmake generated files ---------------------------------------
# Makefiles generated by qmake (also in build directories).
/Makefile
/Makefile.*
# qmake build state/cache files.
.qmake.stash
.qmake.cache

# ---------- Compiled objects --------------------------------------------
*.o
*.obj

# ---------- Visual Studio -------------------------------------------------
# User-specific Visual Studio files.
*.user
*.suo
*.ncb
*.sdf
*.ipch
.vs/

# ---------- Editors ------------------------------------------------------
.vscode/
.idea/
