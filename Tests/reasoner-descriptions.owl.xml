<?xml version="1.0" encoding="UTF-8"?>
<!--
  reasoner-descriptions.owl.xml - the independent reasoners that confirmed test
  expectations. A test links to one of these individuals with
  kt:verifiedResultByReasonerOnVersion (or its divergence counterpart) instead
  of a string literal, so the name and version are stated once.
  The file is not a control ontology (it is not *.kt.owl.xml) and no reasoning
  runs over it.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/reasoners">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

  <Declaration><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5-519"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI="kt:reasoner-elk-0-5-0"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI="kt:reasoner-factpp-1-6-3"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI="kt:reasoner-openllet-2-6-5"/></Declaration>

  <ClassAssertion><Class abbreviatedIRI="kt:Reasoner"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5-519"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerName"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5-519"/><Literal>HermiT</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerVersion"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5-519"/><Literal>1.4.5.519</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerDescription"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5-519"/><Literal>HermiT 1.4.5.519 through the OWL API 5.1.20 (the independent oracle of the completion graph caching suite).</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:Reasoner"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerName"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5"/><Literal>HermiT</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerVersion"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5"/><Literal>1.4.5</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerDescription"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5"/><Literal>HermiT 1.4.5, used for the legacy cross-check of the EL family tests.</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:Reasoner"/><NamedIndividual abbreviatedIRI="kt:reasoner-elk-0-5-0"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerName"/><NamedIndividual abbreviatedIRI="kt:reasoner-elk-0-5-0"/><Literal>ELK</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerVersion"/><NamedIndividual abbreviatedIRI="kt:reasoner-elk-0-5-0"/><Literal>0.5.0</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerDescription"/><NamedIndividual abbreviatedIRI="kt:reasoner-elk-0-5-0"/><Literal>ELK 0.5.0, used for the legacy cross-check of the EL family tests.</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:Reasoner"/><NamedIndividual abbreviatedIRI="kt:reasoner-factpp-1-6-3"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerName"/><NamedIndividual abbreviatedIRI="kt:reasoner-factpp-1-6-3"/><Literal>FaCT++</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerVersion"/><NamedIndividual abbreviatedIRI="kt:reasoner-factpp-1-6-3"/><Literal>1.6.3</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerDescription"/><NamedIndividual abbreviatedIRI="kt:reasoner-factpp-1-6-3"/><Literal>FaCT++ 1.6.3 (JNI) through the OWL API 3.4.10 and the ORE 2015 reasoner wrapper; the second opinion of the DL fuzz campaign and the verifier of the archived OWLlink tests that HermiT does not answer within 60 s.</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:Reasoner"/><NamedIndividual abbreviatedIRI="kt:reasoner-openllet-2-6-5"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerName"/><NamedIndividual abbreviatedIRI="kt:reasoner-openllet-2-6-5"/><Literal>Openllet</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerVersion"/><NamedIndividual abbreviatedIRI="kt:reasoner-openllet-2-6-5"/><Literal>2.6.5</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:reasonerDescription"/><NamedIndividual abbreviatedIRI="kt:reasoner-openllet-2-6-5"/><Literal>Openllet 2.6.5 (openllet-owlapi, OWL API 5); the reference of the realization fuzz tests together with FaCT++ 1.6.3, because HermiT 1.4.5 derives wrong types in some realizations.</Literal></DataPropertyAssertion>
</Ontology>
