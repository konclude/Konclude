<?xml version="1.0" encoding="UTF-8"?>
<!--
  Control ontology for the ABox role-characteristic conformance cases
  (see Docs/Fix-Options-BackendNeighbourExpansionBlocking.md, section 7.B).

  Cases 1-5, 9 and 10 expect INCONSISTENT; cases 6-8 expect CONSISTENT
  the blocking optimisation is still unfixed; remove the markers once the fix
  has been verified (stage 5 of the fix plan).
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/suite/abox">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

  <!-- Suite: the folder containing this control ontology. -->
  <ClassAssertion>
    <Class abbreviatedIRI="kt:TestSuite"/>
    <NamedIndividual abbreviatedIRI="kt:suite-abox"/>
  </ClassAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:suiteName"/>
    <NamedIndividual abbreviatedIRI="kt:suite-abox"/>
    <Literal>ABox-reasoning</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:suiteDirectory"/>
    <NamedIndividual abbreviatedIRI="kt:suite-abox"/>
    <Literal>abox</Literal>
  </DataPropertyAssertion>

  <!-- 1) asymmetric-3-cycle -->
  <ClassAssertion><Class abbreviatedIRI="kt:ConsistencyTest"/><NamedIndividual abbreviatedIRI="kt:asymmetric-3-cycle"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:asymmetric-3-cycle"/><Literal>consistency</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:asymmetric-3-cycle"/><Literal>asymmetric-3-cycle.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:asymmetric-3-cycle"/><Literal>inconsistent</Literal></DataPropertyAssertion>

  <!-- 2) asymmetric-merged -->
  <ClassAssertion><Class abbreviatedIRI="kt:ConsistencyTest"/><NamedIndividual abbreviatedIRI="kt:asymmetric-merged"/></ClassAssertion>
