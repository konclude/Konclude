  <ClassAssertion><Class abbreviatedIRI="kt:ConsistencyTest"/><NamedIndividual abbreviatedIRI="kt:cross-round-universal-propagation"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:cross-round-universal-propagation"/><Literal>cross-round-universal-propagation: a universal restriction whose role successor lives in another saturation round must still reach the real successor. The small-saturation-batch system config forces the cross-round split on this tiny ontology; a : D1 is derived only if the completion materialises the neighbour, so not-D1(a) makes it inconsistent. Without the fix this is wrongly reported consistent.</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:cross-round-universal-propagation"/><Literal>consistency</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:cross-round-universal-propagation"/><Literal>cross-round-universal-propagation.owl.xml</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:usesTestSystemConfig"/><NamedIndividual abbreviatedIRI="kt:cross-round-universal-propagation"/><NamedIndividual IRI="../../configs/small-saturation-batch.xml"/></ObjectPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:cross-round-universal-propagation"/><Literal>inconsistent</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:verifiedResultByReasonerOnVersion"/><NamedIndividual abbreviatedIRI="kt:cross-round-universal-propagation"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5-519"/></ObjectPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:ConsistencyTest"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal"/><Literal>nominal-successor-universal: (exists inverse r0.C0)(a0) with C0 below {a2} makes a2 the r0-predecessor of a0, and C0(a2) with C0 below (all r0.C3) puts a0 into C3, which contradicts not-C3(a0). The individual saturation records a2 as cached neighbour of a0 without propagating the universal restriction of a2 back, so a0 is not completely handled; the completion accepted the cached neighbour a2 as witness of the existential, never built the link and wrongly answered consistent.</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal"/><Literal>consistency</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal"/><Literal>nominal-successor-universal.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal"/><Literal>inconsistent</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:verifiedResultByReasonerOnVersion"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5-519"/></ObjectPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:ConsistencyTest"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-choice"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-choice"/><Literal>nominal-successor-universal-choice: as nominal-successor-universal, but a0 is in (not-C3 or D) and in not-D, so the contradiction is only found by the completion after a0 received C3 over the link from the nominal a2. Wrongly answered consistent when the existential was satisfied by the cached neighbour.</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-choice"/><Literal>consistency</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-choice"/><Literal>nominal-successor-universal-choice.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-choice"/><Literal>inconsistent</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:verifiedResultByReasonerOnVersion"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-choice"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5-519"/></ObjectPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:ConsistencyTest"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-equivalent"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-equivalent"/><Literal>nominal-successor-universal-equivalent: the shape of the fuzzing case seed 2167 with equivalences C0 = {a2} and C2 = {a0}; C2 below (exists inverse r0.C0) and C0 below (all r0.C3) put a0 into C3, while a0 is in C1 and C1 is disjoint with C3. Wrongly answered consistent with and without completion graph caching.</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-equivalent"/><Literal>consistency</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-equivalent"/><Literal>nominal-successor-universal-equivalent.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-equivalent"/><Literal>inconsistent</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:verifiedResultByReasonerOnVersion"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-equivalent"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5-519"/></ObjectPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:ConsistencyTest"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-consistent"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-consistent"/><Literal>nominal-successor-universal-consistent: negative control for nominal-successor-universal without not-C3(a0); a0 receives C3 from the nominal a2 and the ontology stays consistent.</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-consistent"/><Literal>consistency</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-consistent"/><Literal>nominal-successor-universal-consistent.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-consistent"/><Literal>consistent</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:verifiedResultByReasonerOnVersion"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-consistent"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5-519"/></ObjectPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:ConsistencyTest"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-direct"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-direct"/><Literal>nominal-successor-universal-direct: guard with the nominal written directly in the existential, (exists inverse r0.{a2})(a0); C0(a2) and C0 below (all r0.C3) put a0 into C3, and (not-C3 or D)(a0) with not-D(a0) makes both alternatives clash in the completion. This shape is answered through the value rule and was already correct; the test keeps it correct.</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-direct"/><Literal>consistency</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-direct"/><Literal>nominal-successor-universal-direct.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-direct"/><Literal>inconsistent</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:verifiedResultByReasonerOnVersion"/><NamedIndividual abbreviatedIRI="kt:nominal-successor-universal-direct"/><NamedIndividual abbreviatedIRI="kt:reasoner-hermit-1-4-5-519"/></ObjectPropertyAssertion>

