<?xml version="1.0" encoding="UTF-8"?>
<!--
  Negative control for nominal-successor-universal: the same nominal successor
  and universal restriction without the contradicting not-C3(a0). a0 receives C3
  from its r0-predecessor a2 and the ontology stays consistent.

    C0 below {a2}, C0 below (all r0.C3), C0(a2), (exists inverse r0.C0)(a0)

  Expected: consistent (HermiT agrees).
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#" ontologyIRI="http://konclude.test/abox/nominal-successor-universal-consistent">
  <Prefix name="" IRI="http://konclude.test/abox/nominal-successor-universal-consistent#"/>
  <Declaration><Class abbreviatedIRI=":C0"/></Declaration>
  <Declaration><Class abbreviatedIRI=":C3"/></Declaration>
  <Declaration><ObjectProperty abbreviatedIRI=":r0"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI=":a0"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI=":a2"/></Declaration>
  <SubClassOf><Class abbreviatedIRI=":C0"/><ObjectOneOf><NamedIndividual abbreviatedIRI=":a2"/></ObjectOneOf></SubClassOf>
  <SubClassOf><Class abbreviatedIRI=":C0"/><ObjectAllValuesFrom><ObjectProperty abbreviatedIRI=":r0"/><Class abbreviatedIRI=":C3"/></ObjectAllValuesFrom></SubClassOf>
  <ClassAssertion><Class abbreviatedIRI=":C0"/><NamedIndividual abbreviatedIRI=":a2"/></ClassAssertion>
  <ClassAssertion><ObjectSomeValuesFrom><ObjectInverseOf><ObjectProperty abbreviatedIRI=":r0"/></ObjectInverseOf><Class abbreviatedIRI=":C0"/></ObjectSomeValuesFrom><NamedIndividual abbreviatedIRI=":a0"/></ClassAssertion>
</Ontology>
