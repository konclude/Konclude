<?xml version="1.0" encoding="UTF-8"?>
<!--
  As nominal-successor-universal, but the clash only appears inside the completion:
  a0 is in (not-C3 or D) and in not-D, so both alternatives clash once a0 receives
  C3 from its r0-predecessor a2 (the only individual in C0, which is below {a2}).

    C0 below {a2}, C0 below (all r0.C3), C0(a2), (exists inverse r0.C0)(a0),
    (not-C3 or D)(a0), not-D(a0)

  Expected: inconsistent (HermiT agrees).
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#" ontologyIRI="http://konclude.test/abox/nominal-successor-universal-choice">
  <Prefix name="" IRI="http://konclude.test/abox/nominal-successor-universal-choice#"/>
  <Declaration><Class abbreviatedIRI=":C0"/></Declaration>
  <Declaration><Class abbreviatedIRI=":C3"/></Declaration>
  <Declaration><Class abbreviatedIRI=":D"/></Declaration>
  <Declaration><ObjectProperty abbreviatedIRI=":r0"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI=":a0"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI=":a2"/></Declaration>
  <SubClassOf><Class abbreviatedIRI=":C0"/><ObjectOneOf><NamedIndividual abbreviatedIRI=":a2"/></ObjectOneOf></SubClassOf>
  <SubClassOf><Class abbreviatedIRI=":C0"/><ObjectAllValuesFrom><ObjectProperty abbreviatedIRI=":r0"/><Class abbreviatedIRI=":C3"/></ObjectAllValuesFrom></SubClassOf>
  <ClassAssertion><Class abbreviatedIRI=":C0"/><NamedIndividual abbreviatedIRI=":a2"/></ClassAssertion>
  <ClassAssertion><ObjectSomeValuesFrom><ObjectInverseOf><ObjectProperty abbreviatedIRI=":r0"/></ObjectInverseOf><Class abbreviatedIRI=":C0"/></ObjectSomeValuesFrom><NamedIndividual abbreviatedIRI=":a0"/></ClassAssertion>
  <ClassAssertion><ObjectUnionOf><ObjectComplementOf><Class abbreviatedIRI=":C3"/></ObjectComplementOf><Class abbreviatedIRI=":D"/></ObjectUnionOf><NamedIndividual abbreviatedIRI=":a0"/></ClassAssertion>
  <ClassAssertion><ObjectComplementOf><Class abbreviatedIRI=":D"/></ObjectComplementOf><NamedIndividual abbreviatedIRI=":a0"/></ClassAssertion>
</Ontology>
