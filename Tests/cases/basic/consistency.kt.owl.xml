<?xml version="1.0" encoding="UTF-8"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/suite/basic/consistency">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

  <ClassAssertion>
    <Class abbreviatedIRI="kt:TestSuite"/>
    <NamedIndividual abbreviatedIRI="kt:suite-basic"/>
  </ClassAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:suiteName"/>
    <NamedIndividual abbreviatedIRI="kt:suite-basic"/>
    <Literal>Basic-consistency</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:suiteDirectory"/>
    <NamedIndividual abbreviatedIRI="kt:suite-basic"/>
    <Literal>basic</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:description"/>
    <NamedIndividual abbreviatedIRI="kt:suite-basic"/>
    <Literal>Control ontology: describes two consistency tests (one consistent, one inconsistent case). (*.kt.owl.xml under Tests/cases/). Flat format, easy to read with QDomDocument: - test individual typed via ClassAssertion(kt:ConsistencyTest, test) - kt:task as DataPropertyAssertion -&gt; "consistency" - kt:usesOntology as DataPropertyAssertion -&gt; relative ontology file name - kt:expectedResult as DataPropertyAssertion -&gt; "consistent"/"inconsistent"</Literal>
  </DataPropertyAssertion>

  <ClassAssertion>
    <Class abbreviatedIRI="kt:ConsistencyTest"/>
    <NamedIndividual abbreviatedIRI="kt:basic-consistent"/>
  </ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:basic-consistent"/><Literal>Test 1: consistent ontology</Literal></DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:task"/>
    <NamedIndividual abbreviatedIRI="kt:basic-consistent"/>
    <Literal>consistency</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:usesOntology"/>
    <NamedIndividual abbreviatedIRI="kt:basic-consistent"/>
    <Literal>consistent-ontology.owl.xml</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:expectedResult"/>
    <NamedIndividual abbreviatedIRI="kt:basic-consistent"/>
    <Literal>consistent</Literal>
  </DataPropertyAssertion>

  <ClassAssertion>
    <Class abbreviatedIRI="kt:ConsistencyTest"/>
    <NamedIndividual abbreviatedIRI="kt:basic-inconsistent"/>
  </ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:basic-inconsistent"/><Literal>Test 2: inconsistent ontology</Literal></DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:task"/>
    <NamedIndividual abbreviatedIRI="kt:basic-inconsistent"/>
    <Literal>consistency</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:usesOntology"/>
    <NamedIndividual abbreviatedIRI="kt:basic-inconsistent"/>
    <Literal>inconsistent-ontology.owl.xml</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:expectedResult"/>
    <NamedIndividual abbreviatedIRI="kt:basic-inconsistent"/>
    <Literal>inconsistent</Literal>
  </DataPropertyAssertion>

</Ontology>
