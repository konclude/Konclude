<?xml version="1.0" encoding="UTF-8"?>
<!--
  Issue #19: the negated conclusion as an assertion.
  The ontology entails CrowdedScene(s); adding (not CrowdedScene)(s) must make it
  inconsistent. This is the ABox form of the same test and checks that the conflict is
  found when the query concept meets the cached completion graph.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/dl/pigeonhole-negated-conclusion">
  <Prefix name="" IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#"/>
  <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>

  <Declaration><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#CrowdedHole"/></Declaration>
  <Declaration><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#CrowdedScene"/></Declaration>
  <Declaration><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Hole"/></Declaration>
  <Declaration><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Pigeon"/></Declaration>
  <Declaration><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Scene"/></Declaration>
  <Declaration><ObjectProperty IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#sitsAt"/></Declaration>
  <Declaration><ObjectProperty IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#inScene"/></Declaration>
  <Declaration><NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#h1"/></Declaration>
  <Declaration><NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#h2"/></Declaration>
  <Declaration><NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#p1"/></Declaration>
  <Declaration><NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#p2"/></Declaration>
  <Declaration><NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#p3"/></Declaration>
  <Declaration><NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#s"/></Declaration>

  <SubObjectPropertyOf>
    <ObjectProperty IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#sitsAt"/>
    <ObjectProperty IRI="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  </SubObjectPropertyOf>

  <EquivalentClasses>
    <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#CrowdedHole"/>
    <ObjectIntersectionOf>
      <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Hole"/>
      <ObjectMinCardinality cardinality="2">
        <ObjectInverseOf><ObjectProperty IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#sitsAt"/></ObjectInverseOf>
        <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Pigeon"/>
      </ObjectMinCardinality>
    </ObjectIntersectionOf>
  </EquivalentClasses>
  <SubClassOf><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#CrowdedHole"/><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Hole"/></SubClassOf>

  <EquivalentClasses>
    <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#CrowdedScene"/>
    <ObjectIntersectionOf>
      <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Scene"/>
      <ObjectSomeValuesFrom>
        <ObjectInverseOf><ObjectProperty IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#inScene"/></ObjectInverseOf>
        <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#CrowdedHole"/>
      </ObjectSomeValuesFrom>
    </ObjectIntersectionOf>
  </EquivalentClasses>
  <SubClassOf><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#CrowdedScene"/><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Scene"/></SubClassOf>

  <EquivalentClasses>
    <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Hole"/>
    <ObjectOneOf>
      <NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#h1"/>
      <NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#h2"/>
    </ObjectOneOf>
  </EquivalentClasses>
  <SubClassOf>
    <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Hole"/>
    <ObjectSomeValuesFrom>
      <ObjectProperty IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#inScene"/>
      <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Scene"/>
    </ObjectSomeValuesFrom>
  </SubClassOf>

  <EquivalentClasses>
    <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Pigeon"/>
    <ObjectOneOf>
      <NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#p1"/>
      <NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#p2"/>
      <NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#p3"/>
    </ObjectOneOf>
  </EquivalentClasses>
  <SubClassOf>
    <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Pigeon"/>
    <ObjectExactCardinality cardinality="1">
      <ObjectProperty IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#sitsAt"/>
      <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Hole"/>
    </ObjectExactCardinality>
  </SubClassOf>

  <EquivalentClasses>
    <Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Scene"/>
    <ObjectOneOf><NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#s"/></ObjectOneOf>
  </EquivalentClasses>

  <DisjointClasses><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Hole"/><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Pigeon"/></DisjointClasses>
  <DisjointClasses><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Hole"/><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Scene"/></DisjointClasses>
  <DisjointClasses><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Pigeon"/><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#Scene"/></DisjointClasses>
  <DifferentIndividuals>
    <NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#p1"/>
    <NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#p2"/>
    <NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#p3"/>
  </DifferentIndividuals>

  <!-- The entailed conclusion, negated: the knowledge base is inconsistent iff
       Scene is subsumed by CrowdedScene. -->
  <ClassAssertion>
    <ObjectComplementOf><Class IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#CrowdedScene"/></ObjectComplementOf>
    <NamedIndividual IRI="http://konclude.test/dl/pigeonhole-negated-conclusion#s"/>
  </ClassAssertion>
</Ontology>
