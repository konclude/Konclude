<?xml version="1.0" encoding="UTF-8"?>
<!--
  Control ontology for the DL corner cases (consistency tests).
  Each expectation derived from the DL semantics. Picked up by discovery.
  Note: usesOntology is a relative file name in the same directory.
-->
