      <ObjectHasValue><ObjectProperty IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#sitsAt"/><NamedIndividual IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#h1"/></ObjectHasValue>
