  <ClassAssertion><Class IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#Pigeon"/><NamedIndividual IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#a"/></ClassAssertion>
  <ClassAssertion><Class IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#Pigeon"/><NamedIndividual IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#b"/></ClassAssertion>
  <ClassAssertion><Class IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#Pigeon"/><NamedIndividual IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#c"/></ClassAssertion>
  <ClassAssertion><Class IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#Pigeon"/><NamedIndividual IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#d"/></ClassAssertion>
