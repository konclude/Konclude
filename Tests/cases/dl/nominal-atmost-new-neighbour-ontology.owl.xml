<?xml version="1.0" encoding="UTF-8"?>
<!--
  At-most restrictions on nominals that already have neighbours, and a test concept that adds one more.
    h1: <= 1 inverse(sitsAt).Pigeon, the pigeon a sits at h1 by a role assertion
    h2: <= 1 inverse(sitsAt).Pigeon, the pigeon d sits at h2 by (sitsAt value h2)(d)
    h3: <= 2 inverse(sitsAt) (unqualified), a and c sit at h3 by role assertions
  a, b, c, d are pairwise different pigeons. Each test adds the pigeon b as a further neighbour:
    TestBAtH1, TestBAtH2, TestBAtH3 = {b} and (sitsAt value hN)        (unsatisfiable)
    TestNonPigeonAtH1 = not Pigeon and (sitsAt value h1)                (satisfiable control)
  The cached completion graph has to give up the cached state of hN, because the at-most restriction
  was decided without the new neighbour (criterion C4), and the consistency test must not lose the
  re-application of the at-most restriction for new links.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/dl/nominal-atmost-new-neighbour">
  <Prefix name="" IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#"/>
  <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>

  <Declaration><Class IRI="http://konclude.test/dl/nominal-atmost-new-neighbour#Pigeon"/></Declaration>
