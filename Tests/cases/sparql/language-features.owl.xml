  <DisjointClasses><Class IRI="#Adult"/><Class IRI="#Child"/></DisjointClasses>
  <DisjointClasses><Class IRI="#Employee"/><Class IRI="#Student"/></DisjointClasses>

  <EquivalentClasses>
    <Class IRI="#Mother"/>
    <ObjectIntersectionOf><Class IRI="#Woman"/><Class IRI="#Parent"/></ObjectIntersectionOf>
  </EquivalentClasses>
  <EquivalentClasses>
    <Class IRI="#Father"/>
    <ObjectIntersectionOf><Class IRI="#Man"/><Class IRI="#Parent"/></ObjectIntersectionOf>
  </EquivalentClasses>
  <EquivalentClasses>
    <Class IRI="#Grandparent"/>
    <ObjectIntersectionOf>
      <Class IRI="#Person"/>
      <ObjectSomeValuesFrom><ObjectProperty IRI="#hasGrandchild"/><Class IRI="#Person"/></ObjectSomeValuesFrom>
    </ObjectIntersectionOf>
  </EquivalentClasses>
  <EquivalentClasses>
    <Class IRI="#HappyPerson"/>
    <ObjectIntersectionOf>
      <Class IRI="#Person"/>
      <ObjectSomeValuesFrom><ObjectProperty IRI="#hasChild"/><Class IRI="#Woman"/></ObjectSomeValuesFrom>
      <ObjectSomeValuesFrom><ObjectProperty IRI="#hasSpouse"/><Class IRI="#Person"/></ObjectSomeValuesFrom>
    </ObjectIntersectionOf>
  </EquivalentClasses>
  <EquivalentClasses>
    <Class IRI="#Senior"/>
    <ObjectIntersectionOf>
      <Class IRI="#Person"/>
      <DataSomeValuesFrom>
        <DataProperty IRI="#age"/>
        <DatatypeRestriction>
          <Datatype abbreviatedIRI="xsd:integer"/>
          <FacetRestriction facet="http://www.w3.org/2001/XMLSchema#minInclusive">
            <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">65</Literal>
          </FacetRestriction>
        </DatatypeRestriction>
      </DataSomeValuesFrom>
    </ObjectIntersectionOf>
  </EquivalentClasses>
  <EquivalentClasses>
    <Class IRI="#CoreFamily"/>
    <ObjectOneOf>
      <NamedIndividual IRI="#alice"/><NamedIndividual IRI="#bob"/><NamedIndividual IRI="#carol"/>
    </ObjectOneOf>
  </EquivalentClasses>

  <!-- every Parent has at least one child -->
  <SubClassOf>
    <Class IRI="#Parent"/>
    <ObjectMinCardinality cardinality="1"><ObjectProperty IRI="#hasChild"/><Class IRI="#Person"/></ObjectMinCardinality>
  </SubClassOf>
  <!-- MarriedPerson implies an anonymous spouse who is a Woman with a child -->
  <SubClassOf>
    <Class IRI="#MarriedPerson"/>
    <ObjectSomeValuesFrom>
      <ObjectProperty IRI="#hasSpouse"/>
      <ObjectIntersectionOf>
        <Class IRI="#Woman"/>
        <ObjectSomeValuesFrom><ObjectProperty IRI="#hasChild"/><Class IRI="#Person"/></ObjectSomeValuesFrom>
      </ObjectIntersectionOf>
    </ObjectSomeValuesFrom>
  </SubClassOf>

