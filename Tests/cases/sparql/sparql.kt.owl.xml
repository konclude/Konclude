<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPARQL tests (ASK and SELECT). kt:usesDataset is the ontology loaded before
  the query is answered, kt:usesOntology the query file. The file channel runs
  'sparqlfile', the live channel starts 'sparqlserver' and posts the query to
  it. Tests with kt:expectedFile compare the whole SPARQL Results XML document,
  otherwise the <boolean> of an ASK answer is checked.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/suite/sparql">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

  <!-- Suite: the folder containing this control ontology. -->
  <ClassAssertion><Class abbreviatedIRI="kt:TestSuite"/><NamedIndividual abbreviatedIRI="kt:suite-sparql"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteName"/><NamedIndividual abbreviatedIRI="kt:suite-sparql"/><Literal>SPARQL</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteDirectory"/><NamedIndividual abbreviatedIRI="kt:suite-sparql"/><Literal>sparql</Literal></DataPropertyAssertion>

  <!-- File channel: true -->
  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-true"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-true"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-true"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-true"/><Literal>ask-true.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-true"/><Literal>true</Literal></DataPropertyAssertion>

  <!-- File channel: false -->
  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-false"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-false"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-false"/><Literal>../../ontologies/el-aunt.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-false"/><Literal>ask-false.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-false"/><Literal>false</Literal></DataPropertyAssertion>

  <!-- Live SPARQL server: the runner starts 'sparqlserver' with the dataset on a
       free port and posts the query. -->
  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-server-ask-true"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-server-ask-true"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-server-ask-true"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-server-ask-true"/><Literal>ask-true.sparql</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:onChannel"/><NamedIndividual abbreviatedIRI="kt:sparql-server-ask-true"/><NamedIndividual abbreviatedIRI="kt:SPARQLServer"/></ObjectPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:sparql-server-ask-true"/><Literal>true</Literal></DataPropertyAssertion>

  <!-- SELECT over the ABox (two rows, expected file in another order): rows are compared as a set. -->
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-persons"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-persons"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-persons"/><Literal>persons.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:sparql-persons"/><Literal>expected/persons.xml</Literal></DataPropertyAssertion>

  <!-- Same SELECT over the live SPARQL server. -->
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-persons-server"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-persons-server"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-persons-server"/><Literal>persons.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:sparql-persons-server"/><Literal>expected/persons.xml</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:onChannel"/><NamedIndividual abbreviatedIRI="kt:sparql-persons-server"/><NamedIndividual abbreviatedIRI="kt:SPARQLServer"/></ObjectPropertyAssertion>

  <!-- Short timeout for the FILTER test: the query currently does not terminate. -->
  <ClassAssertion><Class abbreviatedIRI="kt:RunConfig"/><NamedIndividual abbreviatedIRI="kt:run-sparql-timeout5"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:runConfigName"/><NamedIndividual abbreviatedIRI="kt:run-sparql-timeout5"/><Literal>sparql-timeout5</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:timeoutSeconds"/><NamedIndividual abbreviatedIRI="kt:run-sparql-timeout5"/><Literal>5</Literal></DataPropertyAssertion>


  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-optional"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-optional"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-optional"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-optional"/><Literal>queries/optional.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:sparql-optional"/><Literal>expected/optional.xml</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:knownFailure"/><NamedIndividual abbreviatedIRI="kt:sparql-optional"/><NamedIndividual abbreviatedIRI="kt:issue-sparql-optional-empty"/></ObjectPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-union"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-union"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-union"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-union"/><Literal>queries/union.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:sparql-union"/><Literal>expected/union.xml</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:knownFailure"/><NamedIndividual abbreviatedIRI="kt:sparql-union"/><NamedIndividual abbreviatedIRI="kt:issue-sparql-union-empty"/></ObjectPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><Literal>queries/filter.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><Literal>expected/filter.xml</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:usesTestRunConfig"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><NamedIndividual abbreviatedIRI="kt:run-sparql-timeout5"/></ObjectPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:knownFailure"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><NamedIndividual abbreviatedIRI="kt:issue-sparql-filter-hang"/></ObjectPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-distinct"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-distinct"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-distinct"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-distinct"/><Literal>queries/distinct.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:sparql-distinct"/><Literal>expected/distinct.xml</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-order-limit"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-order-limit"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-order-limit"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-order-limit"/><Literal>queries/order-limit.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:sparql-order-limit"/><Literal>expected/order-limit.xml</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-complex"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-complex"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-complex"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-complex"/><Literal>queries/ask-complex.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-complex"/><Literal>true</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-distinct-server"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-distinct-server"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-distinct-server"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-distinct-server"/><Literal>queries/distinct.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:sparql-distinct-server"/><Literal>expected/distinct.xml</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:onChannel"/><NamedIndividual abbreviatedIRI="kt:sparql-distinct-server"/><NamedIndividual abbreviatedIRI="kt:SPARQLServer"/></ObjectPropertyAssertion>

</Ontology>
