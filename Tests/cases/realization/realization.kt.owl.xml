<?xml version="1.0" encoding="UTF-8"?>
<!--
  Realization task tests: the runner executes 'Konclude realization -i ... -o ...'
  and compares the computed individual types with an expected OWL/XML result.
  The comparison is order-independent and ignores declarations; see
  CRealizationResultComparator.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/suite/realization">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

  <ClassAssertion><Class abbreviatedIRI="kt:TestSuite"/><NamedIndividual abbreviatedIRI="kt:suite-realization"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteName"/><NamedIndividual abbreviatedIRI="kt:suite-realization"/><Literal>Realization</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteDirectory"/><NamedIndividual abbreviatedIRI="kt:suite-realization"/><Literal>class-realization</Literal></DataPropertyAssertion>

  <!-- Full realization of a family ontology with inverse roles and defined classes. -->
  <ClassAssertion><Class abbreviatedIRI="kt:ClassRealizationTest"/><NamedIndividual abbreviatedIRI="kt:realization-family"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:realization-family"/><Literal>class-realization</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:realization-family"/><Literal>realization-family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:realization-family"/><Literal>expected/realization-family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:description"/>
    <NamedIndividual abbreviatedIRI="kt:realization-family"/>
    <Literal>Realization must infer Woman/Mother/Parent/Grandparent for alice and Man/Father/Parent/Grandparent for bob.</Literal>
  </DataPropertyAssertion>

  <!-- Realization of nominals, role chains and cardinality classes. -->
  <ClassAssertion><Class abbreviatedIRI="kt:ClassRealizationTest"/><NamedIndividual abbreviatedIRI="kt:realization-classification-complex"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:realization-classification-complex"/><Literal>class-realization</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:realization-classification-complex"/><Literal>../owl2-features/classification-complex.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:realization-classification-complex"/><Literal>expected/realization-classification-complex.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:description"/>
    <NamedIndividual abbreviatedIRI="kt:realization-classification-complex"/>
    <Literal>a is in the singleton I and in P; b is in B/J; both inherit A, M, L, R and Thing.</Literal>
  </DataPropertyAssertion>

</Ontology>
