<?xml version="1.0" encoding="UTF-8"?>
<!--
  Satisfiability tests with full class IRIs (kt:testClass) against the shared
  satisfiability-verification-ontology.owl.xml. The fixture contains both
  satisfiable and unsatisfiable named classes, addressed by their full IRI.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/suite/sat">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

  <ClassAssertion><Class abbreviatedIRI="kt:SatisfiabilityTest"/><NamedIndividual abbreviatedIRI="kt:satisfiable-class-a"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:satisfiable-class-a"/><Literal>satisfiability-verification-ontology.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:testClass"/><NamedIndividual abbreviatedIRI="kt:satisfiable-class-a"/><Literal>http://konclude.test/sat#A</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:satisfiable-class-a"/><Literal>satisfiable</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SatisfiabilityTest"/><NamedIndividual abbreviatedIRI="kt:satisfiable-class-c-with-existential-restriction"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:satisfiable-class-c-with-existential-restriction"/><Literal>satisfiability-verification-ontology.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:testClass"/><NamedIndividual abbreviatedIRI="kt:satisfiable-class-c-with-existential-restriction"/><Literal>http://konclude.test/sat#C</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:satisfiable-class-c-with-existential-restriction"/><Literal>satisfiable</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SatisfiabilityTest"/><NamedIndividual abbreviatedIRI="kt:unsatisfiable-class-with-disjoint-axioms"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:unsatisfiable-class-with-disjoint-axioms"/><Literal>satisfiability-verification-ontology.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:testClass"/><NamedIndividual abbreviatedIRI="kt:unsatisfiable-class-with-disjoint-axioms"/><Literal>http://konclude.test/sat#Unsat</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:unsatisfiable-class-with-disjoint-axioms"/><Literal>unsatisfiable</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SatisfiabilityTest"/><NamedIndividual abbreviatedIRI="kt:unsatisfiable-class-with-complement-clash"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:unsatisfiable-class-with-complement-clash"/><Literal>satisfiability-verification-ontology.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:testClass"/><NamedIndividual abbreviatedIRI="kt:unsatisfiable-class-with-complement-clash"/><Literal>http://konclude.test/sat#EmptyInter</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:unsatisfiable-class-with-complement-clash"/><Literal>unsatisfiable</Literal></DataPropertyAssertion>

</Ontology>
