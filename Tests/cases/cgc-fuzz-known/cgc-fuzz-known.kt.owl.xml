<?xml version="1.0" encoding="UTF-8"?>
<!--
  Suite "Completion-graph-caching-fuzz-known": ontologies from the differential fuzzing campaign of the
  completion graph caching (Konclude with and without caching against HermiT) that show problems which
  are not caching criteria: classifications that do not terminate in some configurations, one that does
  not terminate only sometimes, and a wrong subsumption in the classification. The expected taxonomies
  are HermiT's. The non-terminating tests use a short run configuration so that the suite stays fast.
  Tests whose configuration terminates are kept as guards next to the known failures.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
