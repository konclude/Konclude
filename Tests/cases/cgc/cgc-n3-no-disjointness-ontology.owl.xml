<?xml version="1.0" encoding="UTF-8"?>
<!--
  Completion graph caching, family N3: negative control for the blocked-node
  reactivation fix. The shape is family L without the disjointness, so a4 may
  be a C and need not be an A; a1 = a4 is not forced and the equality tests
  must stay satisfiable. A fix that wakes too much or merges the nominals too
  eagerly would make them unsatisfiable.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/cgc/n3">
  <Prefix name="" IRI="http://konclude.test/cgc/n3#"/>

  <Declaration><Class abbreviatedIRI=":A"/></Declaration>
  <Declaration><Class abbreviatedIRI=":B"/></Declaration>
  <Declaration><Class abbreviatedIRI=":C"/></Declaration>
  <Declaration><Class abbreviatedIRI=":D"/></Declaration>
  <Declaration><Class abbreviatedIRI=":TestANotB"/></Declaration>
  <Declaration><Class abbreviatedIRI=":TestA1NotA4"/></Declaration>
  <Declaration><Class abbreviatedIRI=":TestA1A4"/></Declaration>
  <Declaration><Class abbreviatedIRI=":TestA4NotA"/></Declaration>
  <Declaration><ObjectProperty abbreviatedIRI=":r"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI=":a0"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI=":a1"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI=":a4"/></Declaration>

  <EquivalentClasses><Class abbreviatedIRI=":A"/>
    <ObjectOneOf><NamedIndividual abbreviatedIRI=":a0"/><NamedIndividual abbreviatedIRI=":a1"/></ObjectOneOf>
  </EquivalentClasses>
  <EquivalentClasses><Class abbreviatedIRI=":B"/>
    <ObjectOneOf><NamedIndividual abbreviatedIRI=":a0"/><NamedIndividual abbreviatedIRI=":a4"/></ObjectOneOf>
  </EquivalentClasses>
  <SubClassOf><Class abbreviatedIRI=":B"/>
    <ObjectMinCardinality cardinality="2">
      <ObjectProperty abbreviatedIRI=":r"/><Class abbreviatedIRI=":B"/>
    </ObjectMinCardinality>
  </SubClassOf>
  <SubClassOf><Class abbreviatedIRI=":B"/>
    <ObjectUnionOf><Class abbreviatedIRI=":A"/><Class abbreviatedIRI=":C"/></ObjectUnionOf>
  </SubClassOf>
  <SubClassOf>
    <ObjectSomeValuesFrom><ObjectProperty abbreviatedIRI=":r"/><Class abbreviatedIRI=":C"/></ObjectSomeValuesFrom>
    <Class abbreviatedIRI=":D"/>
  </SubClassOf>

  <EquivalentClasses><Class abbreviatedIRI=":TestANotB"/>
    <ObjectIntersectionOf><Class abbreviatedIRI=":A"/><ObjectComplementOf><Class abbreviatedIRI=":B"/></ObjectComplementOf></ObjectIntersectionOf>
  </EquivalentClasses>
  <EquivalentClasses><Class abbreviatedIRI=":TestA1NotA4"/>
    <ObjectIntersectionOf>
      <ObjectOneOf><NamedIndividual abbreviatedIRI=":a1"/></ObjectOneOf>
      <ObjectComplementOf><ObjectOneOf><NamedIndividual abbreviatedIRI=":a4"/></ObjectOneOf></ObjectComplementOf>
    </ObjectIntersectionOf>
  </EquivalentClasses>
  <EquivalentClasses><Class abbreviatedIRI=":TestA1A4"/>
    <ObjectIntersectionOf>
      <ObjectOneOf><NamedIndividual abbreviatedIRI=":a1"/></ObjectOneOf>
      <ObjectOneOf><NamedIndividual abbreviatedIRI=":a4"/></ObjectOneOf>
    </ObjectIntersectionOf>
  </EquivalentClasses>
  <EquivalentClasses><Class abbreviatedIRI=":TestA4NotA"/>
    <ObjectIntersectionOf>
      <ObjectOneOf><NamedIndividual abbreviatedIRI=":a4"/></ObjectOneOf>
      <ObjectComplementOf><Class abbreviatedIRI=":A"/></ObjectComplementOf>
    </ObjectIntersectionOf>
  </EquivalentClasses>
</Ontology>
