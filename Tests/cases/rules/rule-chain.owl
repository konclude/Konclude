Prefix(:=<http://konclude.test/rules#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<http://konclude.test/rules/chain>

Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(NamedIndividual(:a))
ClassAssertion(:A :a)
DLSafeRule(Body(ClassAtom(:A Variable(:x))) Head(ClassAtom(:B Variable(:x))))
DLSafeRule(Body(ClassAtom(:B Variable(:x))) Head(ClassAtom(:C Variable(:x))))
)
