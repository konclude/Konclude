Prefix(:=<http://konclude.test/rules#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<http://konclude.test/rules/different-individuals>

Declaration(Class(:A))
Declaration(Class(:B))
Declaration(NamedIndividual(:a))
Declaration(NamedIndividual(:b))
ClassAssertion(:A :a)
ClassAssertion(:A :b)
DifferentIndividuals(:a :b)
DLSafeRule(Body(ClassAtom(:A Variable(:x)) ClassAtom(:A Variable(:y)) DifferentIndividualsAtom(Variable(:x) Variable(:y))) Head(ClassAtom(:B Variable(:x))))
)
