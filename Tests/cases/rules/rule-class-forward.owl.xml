<?xml version="1.0" encoding="UTF-8"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://konclude.test/rules/class-forward"
     ontologyIRI="http://konclude.test/rules/class-forward">
    <Prefix name="" IRI="http://konclude.test/rules#"/>
    <Declaration><Class IRI="http://konclude.test/rules#A"/></Declaration>
    <Declaration><Class IRI="http://konclude.test/rules#B"/></Declaration>
    <Declaration><NamedIndividual IRI="http://konclude.test/rules#a"/></Declaration>
    <ClassAssertion><Class IRI="http://konclude.test/rules#A"/><NamedIndividual IRI="http://konclude.test/rules#a"/></ClassAssertion>
    <DLSafeRule>
        <Body>
            <ClassAtom><Class IRI="http://konclude.test/rules#A"/><Variable IRI="http://konclude.test/rules#x"/></ClassAtom>
        </Body>
        <Head>
            <ClassAtom><Class IRI="http://konclude.test/rules#B"/><Variable IRI="http://konclude.test/rules#x"/></ClassAtom>
        </Head>
    </DLSafeRule>
</Ontology>
