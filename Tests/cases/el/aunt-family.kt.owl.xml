<?xml version="1.0" encoding="UTF-8"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/suite/el/aunt">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

  <ClassAssertion>
    <Class abbreviatedIRI="kt:TestSuite"/>
    <NamedIndividual abbreviatedIRI="kt:suite-el"/>
  </ClassAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:suiteName"/>
    <NamedIndividual abbreviatedIRI="kt:suite-el"/>
    <Literal>EL-examples</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:suiteDirectory"/>
    <NamedIndividual abbreviatedIRI="kt:suite-el"/>
    <Literal>el</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:description"/>
    <NamedIndividual abbreviatedIRI="kt:suite-el"/>
    <Literal>Control ontology for the EL suite (*.kt.owl.xml). Two tests run on the shared ontology Tests/ontologies/el-aunt.owl.xml, one on role-composition.owl.xml. Contains REAL assertions over the kt: vocabulary (no domain reasoning runs over this; this file only drives the runner). Test group: Test 3: classification through a property chain.</Literal>
  </DataPropertyAssertion>

  <ClassAssertion>
    <Class abbreviatedIRI="kt:ClassClassificationTest"/>
    <NamedIndividual abbreviatedIRI="kt:aunt-family-classification"/>
  </ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:aunt-family-classification"/><Literal>Test 1: classification (default matrix)</Literal></DataPropertyAssertion>
  <!-- shared ontology from the pool, stored once, referenced relatively -->
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:usesOntology"/>
    <NamedIndividual abbreviatedIRI="kt:aunt-family-classification"/>
    <Literal>../../ontologies/el-aunt.owl.xml</Literal>
  </DataPropertyAssertion>
  <ObjectPropertyAssertion>
    <ObjectProperty abbreviatedIRI="kt:onChannel"/>
    <NamedIndividual abbreviatedIRI="kt:aunt-family-classification"/>
    <NamedIndividual abbreviatedIRI="kt:CommandLine"/>
  </ObjectPropertyAssertion>
  <!-- large expectation (whole hierarchy) as a file -->
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:expectedFile"/>
    <NamedIndividual abbreviatedIRI="kt:aunt-family-classification"/>
    <Literal>expected/aunt-family-classification.owl.xml</Literal>
  </DataPropertyAssertion>
  <!-- provenance/attribution -->
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:sourceCase"/>
    <NamedIndividual abbreviatedIRI="kt:aunt-family-classification"/>
    <Literal>ELK el-reasoner family example</Literal>
  </DataPropertyAssertion>
  <!-- cross-confirmation by other reasoners -->
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:verifiedResultByReasonerOnVersion"/>
    <NamedIndividual abbreviatedIRI="kt:aunt-family-classification"/>
    <Literal>ELK 0.5.0</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:verifiedResultByReasonerOnVersion"/>
    <NamedIndividual abbreviatedIRI="kt:aunt-family-classification"/>
    <Literal>HermiT 1.4.5</Literal>
  </DataPropertyAssertion>

  <ClassAssertion>
    <Class abbreviatedIRI="kt:ConsistencyTest"/>
    <NamedIndividual abbreviatedIRI="kt:aunt-family-consistent-without-saturation"/>
  </ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:aunt-family-consistent-without-saturation"/><Literal>Test 2: consistency, additionally without saturation</Literal></DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:usesOntology"/>
    <NamedIndividual abbreviatedIRI="kt:aunt-family-consistent-without-saturation"/>
    <Literal>../../ontologies/el-aunt.owl.xml</Literal>
  </DataPropertyAssertion>
  <!-- additional, test-specific config besides the default matrix -->
  <ObjectPropertyAssertion>
    <ObjectProperty abbreviatedIRI="kt:usesTestSystemConfig"/>
    <NamedIndividual abbreviatedIRI="kt:aunt-family-consistent-without-saturation"/>
    <NamedIndividual IRI="../../configs/no-saturation.xml"/>
  </ObjectPropertyAssertion>
  <!-- small result: inline, no file needed -->
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:expectedResult"/>
    <NamedIndividual abbreviatedIRI="kt:aunt-family-consistent-without-saturation"/>
    <Literal>consistent</Literal>
  </DataPropertyAssertion>

  <ClassAssertion>
    <Class abbreviatedIRI="kt:ClassClassificationTest"/>
    <NamedIndividual abbreviatedIRI="kt:el-role-composition"/>
  </ClassAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:task"/>
    <NamedIndividual abbreviatedIRI="kt:el-role-composition"/>
    <Literal>class-classification</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:usesOntology"/>
    <NamedIndividual abbreviatedIRI="kt:el-role-composition"/>
    <Literal>role-composition.owl.xml</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:expectedFile"/>
    <NamedIndividual abbreviatedIRI="kt:el-role-composition"/>
    <Literal>expected/role-composition-classification.owl.xml</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:description"/>
    <NamedIndividual abbreviatedIRI="kt:el-role-composition"/>
    <Literal>A is subsumed by X through the property chain r o s -> t.</Literal>
  </DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:sourceCase"/>
    <NamedIndividual abbreviatedIRI="kt:el-role-composition"/>
    <Literal>PropertyCompositionsWithHierarchy</Literal>
  </DataPropertyAssertion>

</Ontology>
