<?xml version="1.0" encoding="UTF-8"?>
<RequestMessage xmlns="http://www.owllink.org/owllink-xml#" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:owl="http://www.w3.org/2002/07/owl#" xml:base="http://www.owllink.org/testsuite/3b#"
    xsi:schemaLocation="http://www.owllink.org/owllink-xml# http://www.owllink.org/owllink-xml.xsd">

    <CreateKB kb="http://www.owllink.org/testsuite/3b"/>

    <Tell kb="http://www.owllink.org/testsuite/3b">
        <owl:Declaration>
            <owl:Class IRI="C"/>
        </owl:Declaration>
        <owl:Declaration>
            <owl:Class IRI="P"/>
        </owl:Declaration>
        <owl:Declaration>
            <owl:Class IRI="P1"/>
        </owl:Declaration>
        <owl:Declaration>
            <owl:Class IRI="P2"/>
        </owl:Declaration>
        <owl:Declaration>
            <owl:Class IRI="P3"/>
        </owl:Declaration>
        <owl:Declaration>
            <owl:Class IRI="P4"/>
        </owl:Declaration>
        <owl:Declaration>
            <owl:Class IRI="P5"/>
        </owl:Declaration>
        <owl:Declaration>
            <owl:ObjectProperty IRI="r"/>
        </owl:Declaration>

        <owl:SubClassOf>
            <owl:Class IRI="P1"/>
            <owl:ObjectComplementOf>
                <owl:ObjectUnionOf>
                    <owl:Class IRI="P2"/>
                    <owl:Class IRI="P3"/>
                    <owl:Class IRI="P4"/>
                    <owl:Class IRI="P5"/>
                </owl:ObjectUnionOf>
            </owl:ObjectComplementOf>
        </owl:SubClassOf>

        <owl:SubClassOf>
            <owl:Class IRI="P2"/>
            <owl:ObjectComplementOf>
                <owl:ObjectUnionOf>
                    <owl:Class IRI="P3"/>
                    <owl:Class IRI="P4"/>
                    <owl:Class IRI="P5"/>
                </owl:ObjectUnionOf>
            </owl:ObjectComplementOf>
        </owl:SubClassOf>

        <owl:SubClassOf>
            <owl:Class IRI="P3"/>
            <owl:ObjectComplementOf>
                <owl:ObjectUnionOf>
                    <owl:Class IRI="P4"/>
                    <owl:Class IRI="P5"/>
                </owl:ObjectUnionOf>
            </owl:ObjectComplementOf>
        </owl:SubClassOf>

        <owl:SubClassOf>
            <owl:Class IRI="U"/>
            <owl:ObjectIntersectionOf>
                <owl:ObjectSomeValuesFrom>
                    <owl:ObjectProperty IRI="r"/>
                    <owl:Class IRI="P1"/>
                </owl:ObjectSomeValuesFrom>
                <owl:ObjectSomeValuesFrom>
                    <owl:ObjectProperty IRI="r"/>
                    <owl:Class IRI="P2"/>
                </owl:ObjectSomeValuesFrom>
                <owl:ObjectSomeValuesFrom>
                    <owl:ObjectProperty IRI="r"/>
                    <owl:Class IRI="P3"/>
                </owl:ObjectSomeValuesFrom>
                <owl:ObjectSomeValuesFrom>
                    <owl:ObjectProperty IRI="r"/>
                    <owl:Class IRI="P4"/>
                </owl:ObjectSomeValuesFrom>
                <owl:ObjectSomeValuesFrom>
                    <owl:ObjectProperty IRI="r"/>
                    <owl:ObjectIntersectionOf>
                        <owl:Class IRI="P1"/>
                        <owl:Class IRI="P"/>
                    </owl:ObjectIntersectionOf>
                </owl:ObjectSomeValuesFrom>
                <owl:ObjectSomeValuesFrom>
                    <owl:ObjectProperty IRI="r"/>
                    <owl:ObjectIntersectionOf>
                        <owl:Class IRI="P2"/>
                        <owl:Class IRI="P"/>
                    </owl:ObjectIntersectionOf>
                </owl:ObjectSomeValuesFrom>
                <owl:ObjectSomeValuesFrom>
                    <owl:ObjectProperty IRI="r"/>
                    <owl:ObjectIntersectionOf>
                        <owl:Class IRI="P3"/>
                        <owl:Class IRI="P"/>
                    </owl:ObjectIntersectionOf>
                </owl:ObjectSomeValuesFrom>
                <owl:ObjectMaxCardinality cardinality="3">
                    <owl:ObjectProperty IRI="r"/>
                </owl:ObjectMaxCardinality>
            </owl:ObjectIntersectionOf>
        </owl:SubClassOf>

    </Tell>

    <IsClassSatisfiable kb="http://www.owllink.org/testsuite/3b" timing="simple">
        <owl:Class IRI="U"/>
    </IsClassSatisfiable>

    <ReleaseKB kb="http://www.owllink.org/testsuite/3b"/>

</RequestMessage>
