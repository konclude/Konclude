<?xml version="1.0" encoding="UTF-8"?>
<RequestMessage xmlns="http://www.owllink.org/owllink-xml#" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:owl="http://www.w3.org/2002/07/owl#" xml:base="http://www.owllink.org/testsuite/36#"
    xsi:schemaLocation="http://www.owllink.org/owllink-xml# http://www.owllink.org/owllink-xml.xsd">

    <CreateKB kb="http://www.owllink.org/testsuite/36"/>

    <Tell kb="http://www.owllink.org/testsuite/36">
        
        <owl:Declaration>
            <owl:Class IRI="A"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:Class IRI="negA"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:Class IRI="B"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:Class IRI="negB"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:Class IRI="D"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:Class IRI="negD"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:ObjectProperty IRI="r"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:ObjectProperty IRI="q"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:ObjectProperty IRI="l"/>
        </owl:Declaration>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="A"/>
            <owl:ObjectMinCardinality cardinality="1">
                <owl:ObjectProperty IRI="r"/>
            </owl:ObjectMinCardinality>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="negA"/>
            <owl:ObjectMaxCardinality cardinality="0">
                <owl:ObjectProperty IRI="r"/>
            </owl:ObjectMaxCardinality>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="B"/>
            <owl:ObjectMinCardinality cardinality="1">
                <owl:ObjectProperty IRI="l"/>
            </owl:ObjectMinCardinality>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="negB"/>
            <owl:ObjectMaxCardinality cardinality="0">
                <owl:ObjectProperty IRI="l"/>
            </owl:ObjectMaxCardinality>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="negD"/>
            <owl:ObjectMaxCardinality cardinality="0">
                <owl:ObjectProperty IRI="q"/>
            </owl:ObjectMaxCardinality>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="D"/>
            <owl:ObjectIntersectionOf>
                <owl:Class IRI="negA"/>
                <owl:Class IRI="negB"/>
            </owl:ObjectIntersectionOf>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:ObjectMinCardinality cardinality="1">
                <owl:ObjectProperty IRI="q"/>
            </owl:ObjectMinCardinality>
            <owl:Class IRI="D"/>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="AorB"/>
            <owl:ObjectUnionOf>
                <owl:Class IRI="A"/>
                <owl:Class IRI="B"/>
            </owl:ObjectUnionOf>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="H"/>
            <owl:ObjectIntersectionOf>
                <owl:Class IRI="negD"/>
                <owl:ObjectComplementOf>
                    <owl:Class IRI="AorB"/>
                </owl:ObjectComplementOf>
            </owl:ObjectIntersectionOf>
        </owl:EquivalentClasses>

    </Tell>

    <IsClassSatisfiable kb="http://www.owllink.org/testsuite/36" timing="simple">
        <owl:Class IRI="H"/>
	</IsClassSatisfiable>

    <ReleaseKB kb="http://www.owllink.org/testsuite/36"/>

</RequestMessage>
