<?xml version="1.0" encoding="UTF-8"?>
<RequestMessage xmlns="http://www.owllink.org/owllink-xml#" xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xml:base="http://www.owllink.org/testsuite/6#"
    xsi:schemaLocation="http://www.owllink.org/owllink-xml# http://www.owllink.org/owllink-xml.xsd">

    <CreateKB kb="http://www.owllink.org/testsuite/6"/>

    <Tell kb="http://www.owllink.org/testsuite/6">

        <owl:Declaration>
            <owl:Class IRI="Al1r"/>
        </owl:Declaration>

        <owl:Declaration>
            <owl:Class IRI="AllrinegA"/>
        </owl:Declaration>

        <owl:Declaration>
            <owl:Class IRI="A"/>
        </owl:Declaration>

        <owl:Declaration>
            <owl:Class IRI="negA"/>
        </owl:Declaration>

        <owl:Declaration>
            <owl:Class IRI="Allr"/>
        </owl:Declaration>

        <owl:Declaration>
            <owl:Class IRI="Allri1"/>
        </owl:Declaration>

        <owl:Declaration>
            <owl:Class IRI="E"/>
        </owl:Declaration>

        <owl:Declaration>
            <owl:ObjectProperty IRI="r"/>
        </owl:Declaration>

        <owl:Declaration>
            <owl:ObjectProperty IRI="ri"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:ObjectProperty IRI="q"/>
        </owl:Declaration>
        
        <owl:InverseObjectProperties>
            <owl:ObjectProperty IRI="r"/>
            <owl:ObjectProperty IRI="ri"/>
        </owl:InverseObjectProperties>

        <owl:EquivalentClasses>
            <owl:Class IRI="Al1r"/>
            <owl:ObjectMinCardinality cardinality="1">
                <owl:ObjectProperty IRI="r"/>
            </owl:ObjectMinCardinality>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="AllrinegA"/>
            <owl:ObjectAllValuesFrom>
                <owl:ObjectProperty IRI="ri"/>
                <owl:Class IRI="negA"/>
            </owl:ObjectAllValuesFrom>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="A"/>
            <owl:ObjectMinCardinality cardinality="1">
                <owl:ObjectProperty IRI="q"/>
            </owl:ObjectMinCardinality>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="negA"/>
            <owl:ObjectExactCardinality cardinality="0">
                <owl:ObjectProperty IRI="q"/>
            </owl:ObjectExactCardinality>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="Allr"/>
            <owl:ObjectAllValuesFrom>
                <owl:ObjectProperty IRI="r"/>
                <owl:Class IRI="Allri1"/>
            </owl:ObjectAllValuesFrom>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="Allri1"/>
            <owl:ObjectAllValuesFrom>
                <owl:ObjectProperty IRI="ri"/>
                <owl:Class IRI="AllrinegA"/>
            </owl:ObjectAllValuesFrom>
        </owl:EquivalentClasses>
        
        <owl:EquivalentClasses>
            <owl:Class IRI="E"/>
            <owl:ObjectIntersectionOf>
                <owl:Class IRI="A"/>
                <owl:ObjectSomeValuesFrom>
                    <owl:ObjectProperty IRI="r"/>
                    <owl:Class IRI="Al1r"/>
                </owl:ObjectSomeValuesFrom>
                <owl:ObjectAllValuesFrom>
                    <owl:ObjectProperty IRI="r"/>
                    <owl:Class IRI="Allr"/>
                </owl:ObjectAllValuesFrom>
            </owl:ObjectIntersectionOf>
        </owl:EquivalentClasses>

    </Tell>
    
    
    <IsClassSatisfiable kb="http://www.owllink.org/testsuite/6" timing="simple">
        <owl:Class IRI="E"/>
    </IsClassSatisfiable>
    
    <ReleaseKB kb="http://www.owllink.org/testsuite/6"/>
    
</RequestMessage>
