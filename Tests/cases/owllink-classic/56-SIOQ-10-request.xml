<?xml version="1.0" encoding="UTF-8"?>
<RequestMessage xmlns="http://www.owllink.org/owllink-xml#"
    xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xml:base="http://www.owllink.org/testsuite/56#"
    xsi:schemaLocation="http://www.owllink.org/owllink-xml# http://www.owllink.org/owllink-xml.xsd">

    <CreateKB kb="http://www.owllink.org/testsuite/56"/>

    <Tell kb="http://www.owllink.org/testsuite/56">

		<owl:Declaration>
			<owl:Class IRI="#A"/>
		</owl:Declaration>
		<owl:Declaration>
			<owl:Class IRI="#C"/>
		</owl:Declaration>
		<owl:Declaration>
			<owl:Class IRI="#D"/>
		</owl:Declaration>
		<owl:Declaration>
			<owl:ObjectProperty IRI="#r"/>
		</owl:Declaration>
		<owl:Declaration>
			<owl:ObjectProperty IRI="#s"/>
		</owl:Declaration>
		<owl:Declaration>
			<owl:ObjectProperty IRI="#sInv"/>
		</owl:Declaration>
		<owl:Declaration>
			<owl:NamedIndividual IRI="#a"/>
		</owl:Declaration>
		<owl:SubClassOf>
			<owl:Class IRI="#A"/>
			<owl:ObjectMaxCardinality cardinality="10">
				<owl:ObjectProperty IRI="#sInv"/>
			</owl:ObjectMaxCardinality>
		</owl:SubClassOf>
		<owl:SubClassOf>
			<owl:Class IRI="#C"/>
			<owl:ObjectIntersectionOf>
				<owl:ObjectSomeValuesFrom>
					<owl:ObjectProperty IRI="#r"/>
					<owl:Class IRI="#C"/>
				</owl:ObjectSomeValuesFrom>
				<owl:ObjectHasValue>
					<owl:ObjectProperty IRI="#s"/>
					<owl:NamedIndividual IRI="#a"/>
				</owl:ObjectHasValue>
				<owl:ObjectAllValuesFrom>
					<owl:ObjectProperty IRI="#r"/>
					<owl:ObjectComplementOf>
						<owl:Class IRI="#D"/>
					</owl:ObjectComplementOf>
				</owl:ObjectAllValuesFrom>
			</owl:ObjectIntersectionOf>
		</owl:SubClassOf>
		<owl:SubClassOf>
			<owl:Class IRI="#D"/>
			<owl:Class IRI="#C"/>
		</owl:SubClassOf>
		<owl:ClassAssertion>
			<owl:Class IRI="#A"/>
			<owl:NamedIndividual IRI="#a"/>
		</owl:ClassAssertion>
		<owl:InverseObjectProperties>
			<owl:ObjectProperty IRI="#sInv"/>
			<owl:ObjectProperty IRI="#s"/>
		</owl:InverseObjectProperties>
		<owl:InverseFunctionalObjectProperty>
			<owl:ObjectProperty IRI="#r"/>
		</owl:InverseFunctionalObjectProperty>

   
   </Tell>

    <IsClassSatisfiable kb="http://www.owllink.org/testsuite/56" timing="simple">
        <owl:Class IRI="#D"/>
    </IsClassSatisfiable>

    <ReleaseKB kb="http://www.owllink.org/testsuite/56"/>

</RequestMessage>
