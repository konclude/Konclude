<?xml version="1.0" encoding="UTF-8"?>
<RequestMessage xmlns="http://www.owllink.org/owllink-xml#"
    xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xml:base="http://www.owllink.org/testsuite/43#"
    xsi:schemaLocation="http://www.owllink.org/owllink-xml# http://www.owllink.org/owllink-xml.xsd">

    <CreateKB kb="http://www.owllink.org/testsuite/43"/>

    <Tell kb="http://www.owllink.org/testsuite/43">

        <owl:Declaration>
            <owl:Class IRI="A"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:Class IRI="C"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:ObjectProperty IRI="r"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:ObjectProperty IRI="p"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:ObjectProperty IRI="s"/>
        </owl:Declaration>
        
        <owl:SubObjectPropertyOf>
            <owl:ObjectProperty IRI="r"/>
            <owl:ObjectProperty IRI="s"/>
        </owl:SubObjectPropertyOf>
        
        <owl:SubObjectPropertyOf>
            <owl:ObjectProperty IRI="p"/>
            <owl:ObjectProperty IRI="s"/>
        </owl:SubObjectPropertyOf>
        
        <owl:ObjectPropertyRange>
            <owl:ObjectProperty IRI="r"/>
            <owl:Class IRI="A"/>
        </owl:ObjectPropertyRange>
        
        <owl:ObjectPropertyRange>
            <owl:ObjectProperty IRI="p"/>
            <owl:ObjectComplementOf>
                <owl:Class IRI="A"/>
            </owl:ObjectComplementOf>
        </owl:ObjectPropertyRange>
        
        <owl:SubClassOf>
            <owl:Class IRI="C"/>
            <owl:ObjectIntersectionOf>
               <owl:ObjectMinCardinality cardinality="2">
                   <owl:ObjectProperty IRI="r"/>
               </owl:ObjectMinCardinality>
                <owl:ObjectMinCardinality cardinality="2">
                    <owl:ObjectProperty IRI="p"/>
                </owl:ObjectMinCardinality>
                <owl:ObjectMaxCardinality cardinality="3">
                    <owl:ObjectProperty IRI="s"/>
                </owl:ObjectMaxCardinality>
            </owl:ObjectIntersectionOf>
        </owl:SubClassOf>

    </Tell>

    <IsClassSatisfiable kb="http://www.owllink.org/testsuite/43" timing="simple">
        <owl:Class IRI="C"/>
    </IsClassSatisfiable>

    <ReleaseKB kb="http://www.owllink.org/testsuite/43"/>

</RequestMessage>
