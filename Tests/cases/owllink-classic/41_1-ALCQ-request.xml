<?xml version="1.0" encoding="UTF-8"?>
<RequestMessage xmlns="http://www.owllink.org/owllink-xml#"
    xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xml:base="http://www.owllink.org/testsuite/41#"
    xsi:schemaLocation="http://www.owllink.org/owllink-xml# http://www.owllink.org/owllink-xml.xsd">

    <CreateKB kb="http://www.owllink.org/testsuite/41"/>

    <Tell kb="http://www.owllink.org/testsuite/41">

        <owl:Declaration>
            <owl:Class IRI="A"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:Class IRI="C"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:Class IRI="D"/>
        </owl:Declaration>
        
        <owl:Declaration>
            <owl:Class IRI="E"/>
        </owl:Declaration>

        <owl:Declaration>
            <owl:Class IRI="Z"/>
        </owl:Declaration>

        <owl:Declaration>
            <owl:ObjectProperty IRI="r"/>
        </owl:Declaration>
        
        <owl:SubClassOf>
            <owl:Class IRI="Z"/>
            <owl:ObjectIntersectionOf>
                <owl:ObjectMinCardinality cardinality="1">
                    <owl:ObjectProperty IRI="r"/>
                    <owl:Class IRI="A"/>
                </owl:ObjectMinCardinality>
                <owl:ObjectMinCardinality cardinality="3">
                    <owl:ObjectProperty IRI="r"/>
                    <owl:Class IRI="C"/>
                </owl:ObjectMinCardinality>
                <owl:ObjectMinCardinality cardinality="3">
                    <owl:ObjectProperty IRI="r"/>
                    <owl:Class IRI="D"/>
                </owl:ObjectMinCardinality>
                <owl:ObjectMinCardinality cardinality="3">
                    <owl:ObjectProperty IRI="r"/>
                    <owl:ObjectIntersectionOf>
                        <owl:Class IRI="E"/>
                        <owl:ObjectComplementOf>
                            <owl:ObjectIntersectionOf>
                                <owl:Class IRI="C"/>
                                <owl:Class IRI="D"/>
                            </owl:ObjectIntersectionOf>
                        </owl:ObjectComplementOf>
                    </owl:ObjectIntersectionOf>
                </owl:ObjectMinCardinality>
                <owl:ObjectMinCardinality cardinality="1">
                    <owl:ObjectProperty IRI="r"/>
                    <owl:ObjectIntersectionOf>
                        <owl:Class IRI="E"/>
                        <owl:Class IRI="C"/>
                        <owl:Class IRI="D"/>
                    </owl:ObjectIntersectionOf>
                </owl:ObjectMinCardinality>
                <owl:ObjectMaxCardinality cardinality="4">
                    <owl:ObjectProperty IRI="r"/>
                </owl:ObjectMaxCardinality>
                <owl:ObjectAllValuesFrom>
                    <owl:ObjectProperty IRI="r"/>
                    <owl:ObjectUnionOf>
                        <owl:Class IRI="C"/>
                        <owl:Class IRI="A"/>
                    </owl:ObjectUnionOf>
                </owl:ObjectAllValuesFrom>
            </owl:ObjectIntersectionOf>
        </owl:SubClassOf>

    </Tell>

    <IsClassSatisfiable kb="http://www.owllink.org/testsuite/41" timing="simple">
        <owl:Class IRI="Z"/>
    </IsClassSatisfiable>

    <ReleaseKB kb="http://www.owllink.org/testsuite/41"/>

</RequestMessage>
