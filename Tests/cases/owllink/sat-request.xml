<?xml version="1.0" encoding="UTF-8"?>
<RequestMessage xmlns="http://www.owllink.org/owllink#"
    xmlns:owl="http://www.w3.org/2002/07/owl#">
  <CreateKB kb="http://ex.test/kb"/>
  <Tell kb="http://ex.test/kb">
    <owl:Declaration><owl:Class IRI="#A"/></owl:Declaration>
    <owl:Declaration><owl:Class IRI="#B"/></owl:Declaration>
    <owl:SubClassOf><owl:Class IRI="#B"/><owl:Class IRI="#A"/></owl:SubClassOf>
  </Tell>
  <IsClassSatisfiable kb="http://ex.test/kb"><owl:Class IRI="#B"/></IsClassSatisfiable>
  <ReleaseKB kb="http://ex.test/kb"/>
</RequestMessage>
