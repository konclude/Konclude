<?xml version="1.0" encoding="UTF-8"?>
<!--
  AreClassesDisjoint over a declared-disjoint pair.  Expected answer: true.
-->
<RequestMessage xmlns="http://www.owllink.org/owllink#" xmlns:owl="http://www.w3.org/2002/07/owl#">
  <CreateKB kb="http://ex.test/kb"/>
  <Tell kb="http://ex.test/kb">
    <owl:Declaration><owl:Class IRI="#A"/></owl:Declaration>
    <owl:Declaration><owl:Class IRI="#E"/></owl:Declaration>
    <owl:Declaration><owl:NamedIndividual IRI="#a1"/></owl:Declaration>
    <owl:Declaration><owl:NamedIndividual IRI="#e1"/></owl:Declaration>
    <owl:DisjointClasses><owl:Class IRI="#A"/><owl:Class IRI="#E"/></owl:DisjointClasses>
    <owl:ClassAssertion><owl:Class IRI="#A"/><owl:NamedIndividual IRI="#a1"/></owl:ClassAssertion>
    <owl:ClassAssertion><owl:Class IRI="#E"/><owl:NamedIndividual IRI="#e1"/></owl:ClassAssertion>
  </Tell>
  <AreClassesDisjoint kb="http://ex.test/kb"><owl:Class IRI="#A"/><owl:Class IRI="#E"/></AreClassesDisjoint>
  <ReleaseKB kb="http://ex.test/kb"/>
</RequestMessage>
