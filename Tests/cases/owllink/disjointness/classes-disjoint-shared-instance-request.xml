<?xml version="1.0" encoding="UTF-8"?>
<!--
  AreClassesDisjoint over a pair with a common asserted instance: a1 is both
  an A and a B, so the intersection is not empty.  Expected answer: false.
-->
<RequestMessage xmlns="http://www.owllink.org/owllink#" xmlns:owl="http://www.w3.org/2002/07/owl#">
  <CreateKB kb="http://ex.test/kb"/>
  <Tell kb="http://ex.test/kb">
    <owl:Declaration><owl:Class IRI="#A"/></owl:Declaration>
    <owl:Declaration><owl:Class IRI="#B"/></owl:Declaration>
    <owl:Declaration><owl:NamedIndividual IRI="#a1"/></owl:Declaration>
    <owl:ClassAssertion><owl:Class IRI="#A"/><owl:NamedIndividual IRI="#a1"/></owl:ClassAssertion>
    <owl:ClassAssertion><owl:Class IRI="#B"/><owl:NamedIndividual IRI="#a1"/></owl:ClassAssertion>
  </Tell>
  <AreClassesDisjoint kb="http://ex.test/kb"><owl:Class IRI="#A"/><owl:Class IRI="#B"/></AreClassesDisjoint>
  <ReleaseKB kb="http://ex.test/kb"/>
</RequestMessage>
