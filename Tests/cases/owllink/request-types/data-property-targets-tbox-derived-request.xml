<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWLlink data-property request-type coverage: data-property-targets-tbox-derived.
  The request is self-contained: it creates a KB, tells the test ontology and asks the query.
-->
<RequestMessage xmlns="http://www.owllink.org/owllink#" xmlns:owl="http://www.w3.org/2002/07/owl#">
  <CreateKB kb="http://ex.test/kb"/>
  <Tell kb="http://ex.test/kb">
    <owl:Declaration><owl:DataProperty IRI="#dp1"/></owl:Declaration>
    <owl:Declaration><owl:DataProperty IRI="#dp2"/></owl:Declaration>
    <owl:Declaration><owl:NamedIndividual IRI="#a"/></owl:Declaration>
    <owl:Declaration><owl:NamedIndividual IRI="#b"/></owl:Declaration>
    <owl:Declaration><owl:NamedIndividual IRI="#c"/></owl:Declaration>
    <owl:Declaration><owl:Class IRI="#B"/></owl:Declaration>
    <owl:Declaration><owl:Class IRI="#C"/></owl:Declaration>
    <owl:SubClassOf><owl:Class IRI="#B"/><owl:Class IRI="#C"/></owl:SubClassOf>
    <owl:SubClassOf>
      <owl:Class IRI="#C"/>
      <owl:DataHasValue>
        <owl:DataProperty IRI="#dp1"/>
        <owl:Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">tbox</owl:Literal>
      </owl:DataHasValue>
    </owl:SubClassOf>
    <owl:ClassAssertion><owl:Class IRI="#B"/><owl:NamedIndividual IRI="#c"/></owl:ClassAssertion>
  </Tell>
  <GetDataPropertyTargets kb="http://ex.test/kb" id="q-targets">
    <owl:NamedIndividual IRI="#c"/>
    <owl:DataProperty IRI="#dp1"/>
  </GetDataPropertyTargets>
</RequestMessage>