<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWLlink data-property request-type coverage: data-property-targets-union-forced-value-mixed.
  Both branches of the union force the same value, but through different restriction kinds
  (a hasValue restriction and a minimum cardinality restriction with a literal-only range).
  The value is derived in a non-deterministic branch, so it can only be answered after the
  candidate has been verified by a satisfiability test.
-->
<RequestMessage xmlns="http://www.owllink.org/owllink#" xmlns:owl="http://www.w3.org/2002/07/owl#">
  <CreateKB kb="http://ex.test/kb"/>
  <Tell kb="http://ex.test/kb">
    <owl:Declaration><owl:DataProperty IRI="#dp1"/></owl:Declaration>
    <owl:Declaration><owl:NamedIndividual IRI="#a"/></owl:Declaration>
    <owl:Declaration><owl:Class IRI="#C"/></owl:Declaration>
    <owl:Declaration><owl:Class IRI="#D1"/></owl:Declaration>
    <owl:Declaration><owl:Class IRI="#D2"/></owl:Declaration>
    <owl:SubClassOf><owl:Class IRI="#C"/><owl:ObjectUnionOf><owl:Class IRI="#D1"/><owl:Class IRI="#D2"/></owl:ObjectUnionOf></owl:SubClassOf>
    <owl:SubClassOf>
      <owl:Class IRI="#D1"/>
      <owl:DataHasValue>
        <owl:DataProperty IRI="#dp1"/>
        <owl:Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">mixed</owl:Literal>
      </owl:DataHasValue>
    </owl:SubClassOf>
    <owl:SubClassOf>
      <owl:Class IRI="#D2"/>
      <owl:DataMinCardinality cardinality="1">
        <owl:DataProperty IRI="#dp1"/>
        <owl:DataOneOf><owl:Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">mixed</owl:Literal></owl:DataOneOf>
      </owl:DataMinCardinality>
    </owl:SubClassOf>
    <owl:ClassAssertion><owl:Class IRI="#C"/><owl:NamedIndividual IRI="#a"/></owl:ClassAssertion>
  </Tell>
  <GetDataPropertyTargets kb="http://ex.test/kb" id="q-targets">
    <owl:NamedIndividual IRI="#a"/>
    <owl:DataProperty IRI="#dp1"/>
  </GetDataPropertyTargets>
</RequestMessage>
