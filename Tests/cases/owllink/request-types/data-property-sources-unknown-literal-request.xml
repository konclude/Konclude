<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWLlink data-property request-type coverage: data-property-sources-unknown-literal.
  The literal "missing" does not occur in the loaded ontology, so no individual is a source of
  the data property for it and the answer is empty (the request must not fail).
-->
<RequestMessage xmlns="http://www.owllink.org/owllink#" xmlns:owl="http://www.w3.org/2002/07/owl#">
  <CreateKB kb="http://ex.test/data-property-facts"/>
  <LoadOntologies kb="http://ex.test/data-property-facts">
    <OntologyIRI IRI="file:data-property-facts.owl.xml"/>
  </LoadOntologies>
  <GetDataPropertySources kb="http://ex.test/data-property-facts" id="q-data-property-sources-unknown-literal">
    <owl:DataProperty IRI="#dp1"/>
    <owl:Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">missing</owl:Literal>
  </GetDataPropertySources>
</RequestMessage>
