<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWLlink request-type coverage.

  One test per OWLlink request type: boolean requests use kt:expectedResult,
  result-set requests use an expected response document (kt:expectedFile).
  All requests share the same small ontology so the expected answers are
  easy to verify by hand.
-->
