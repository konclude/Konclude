          ontologyIRI="http://konclude.test/suite/owllink-request-types">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>
  <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>

