  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteDirectory"/><NamedIndividual abbreviatedIRI="kt:suite-owllink-requests"/><Literal>owllink/request-types</Literal></DataPropertyAssertion>

