<?xml version="1.0" encoding="UTF-8"?>
<!--
  Consistency coverage for OWL 2 axioms that are not exercised by the
  satisfiability suite: keys, negative assertions, datatype ranges, nominals,
  punning, annotations, disjoint roles and role chains.
-->
