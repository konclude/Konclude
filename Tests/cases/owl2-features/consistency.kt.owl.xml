          ontologyIRI="http://konclude.test/suite/owl2-features-consistency">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>
  <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>

  <ClassAssertion><Class abbreviatedIRI="kt:TestSuite"/><NamedIndividual abbreviatedIRI="kt:suite-owl2-consistency"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteName"/><NamedIndividual abbreviatedIRI="kt:suite-owl2-consistency"/><Literal>Consistency-OWL2-features</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteDirectory"/><NamedIndividual abbreviatedIRI="kt:suite-owl2-consistency"/><Literal>owl2-features</Literal></DataPropertyAssertion>


