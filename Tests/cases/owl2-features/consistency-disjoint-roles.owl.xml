<?xml version="1.0" encoding="UTF-8"?>
<!-- Disjoint object properties cannot share the same pair of individuals. -->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/features/disjoint-roles">
  <Prefix name="" IRI="http://konclude.test/features/disjoint-roles#"/>

  <Declaration><ObjectProperty abbreviatedIRI=":parentOf"/></Declaration>
  <Declaration><ObjectProperty abbreviatedIRI=":childOf"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI=":alice"/></Declaration>
  <Declaration><NamedIndividual abbreviatedIRI=":bob"/></Declaration>

  <DisjointObjectProperties>
    <ObjectProperty abbreviatedIRI=":parentOf"/>
    <ObjectProperty abbreviatedIRI=":childOf"/>
  </DisjointObjectProperties>
  <ObjectPropertyAssertion>
    <ObjectProperty abbreviatedIRI=":parentOf"/>
    <NamedIndividual abbreviatedIRI=":alice"/>
    <NamedIndividual abbreviatedIRI=":bob"/>
  </ObjectPropertyAssertion>
  <ObjectPropertyAssertion>
    <ObjectProperty abbreviatedIRI=":childOf"/>
    <NamedIndividual abbreviatedIRI=":alice"/>
    <NamedIndividual abbreviatedIRI=":bob"/>
  </ObjectPropertyAssertion>
</Ontology>
