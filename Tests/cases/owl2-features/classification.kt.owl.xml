<?xml version="1.0" encoding="UTF-8"?>
<!--
  Classification coverage: the computed taxonomy is compared with the expected
  OWL/XML taxonomy. The fixture exercises equivalence, unsatisfiable classes,
  nominals, role chains and cardinalities.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/suite/owl2-features-classification">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

  <ClassAssertion><Class abbreviatedIRI="kt:TestSuite"/><NamedIndividual abbreviatedIRI="kt:suite-owl2-classification"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteName"/><NamedIndividual abbreviatedIRI="kt:suite-owl2-classification"/><Literal>Classification-OWL2-features</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteDirectory"/><NamedIndividual abbreviatedIRI="kt:suite-owl2-classification"/><Literal>owl2-features</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:ClassClassificationTest"/><NamedIndividual abbreviatedIRI="kt:classification-complex"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:classification-complex"/><Literal>class-classification</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:classification-complex"/><Literal>classification-complex.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:classification-complex"/><Literal>expected/classification-complex.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:description"/>
    <NamedIndividual abbreviatedIRI="kt:classification-complex"/>
    <Literal>Direct superclasses include A to M (role chain) and B to A; F collapses into owl:Nothing and C/E/G into one synset.</Literal>
  </DataPropertyAssertion>

</Ontology>
