<?xml version="1.0" encoding="UTF-8"?>
<!--
  kt-vocabulary.owl.xml - the vocabulary of the Konclude test control ontologies.
  Declares the classes and properties used in the *.kt.owl.xml files.
  No domain reasoning runs over this ontology; it only documents the
  vocabulary (the runner reads the assertions directly).
  Namespace: http://konclude.test/vocabulary#   (prefix kt:)
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/vocabulary">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>
  <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
  <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>

  <!-- ===== Test kinds (classes) ===== -->
  <Declaration><Class abbreviatedIRI="kt:Test"/></Declaration>
  <Declaration><Class abbreviatedIRI="kt:ConsistencyTest"/></Declaration>
  <Declaration><Class abbreviatedIRI="kt:ClassificationTest"/></Declaration>
  <Declaration><Class abbreviatedIRI="kt:SatisfiabilityTest"/></Declaration>
  <Declaration><Class abbreviatedIRI="kt:RealizationTest"/></Declaration>
  <Declaration><Class abbreviatedIRI="kt:EntailmentTest"/></Declaration>
  <Declaration><Class abbreviatedIRI="kt:SparqlTest"/></Declaration>
  <Declaration><Class abbreviatedIRI="kt:FlakyTest"/></Declaration>
  <SubClassOf><Class abbreviatedIRI="kt:ConsistencyTest"/><Class abbreviatedIRI="kt:Test"/></SubClassOf>
  <SubClassOf><Class abbreviatedIRI="kt:ClassificationTest"/><Class abbreviatedIRI="kt:Test"/></SubClassOf>
  <SubClassOf><Class abbreviatedIRI="kt:SatisfiabilityTest"/><Class abbreviatedIRI="kt:Test"/></SubClassOf>
  <SubClassOf><Class abbreviatedIRI="kt:RealizationTest"/><Class abbreviatedIRI="kt:Test"/></SubClassOf>
  <SubClassOf><Class abbreviatedIRI="kt:EntailmentTest"/><Class abbreviatedIRI="kt:Test"/></SubClassOf>
  <SubClassOf><Class abbreviatedIRI="kt:SparqlTest"/><Class abbreviatedIRI="kt:Test"/></SubClassOf>
  <SubClassOf><Class abbreviatedIRI="kt:FlakyTest"/><Class abbreviatedIRI="kt:Test"/></SubClassOf>

  <!-- Groups of tests and their execution configurations -->
  <Declaration><Class abbreviatedIRI="kt:TestSuite"/></Declaration>
  <Declaration><Class abbreviatedIRI="kt:RunConfig"/></Declaration>

  <!-- Issue (known failure) and test result -->
  <Declaration><Class abbreviatedIRI="kt:Issue"/></Declaration>
  <Declaration><Class abbreviatedIRI="kt:TestResult"/></Declaration>
  <!-- Default config declaration (used in configs.kt.owl.xml) -->
  <Declaration><Class abbreviatedIRI="kt:ConfigSet"/></Declaration>

  <!-- ===== Object Properties ===== -->
  <Declaration><ObjectProperty abbreviatedIRI="kt:memberOfSuite"/></Declaration>
  <Declaration><ObjectProperty abbreviatedIRI="kt:usesTestRunConfig"/></Declaration>
  <Declaration><ObjectProperty abbreviatedIRI="kt:usesTestSystemConfig"/></Declaration>
  <Declaration><ObjectProperty abbreviatedIRI="kt:onChannel"/></Declaration>
  <Declaration><ObjectProperty abbreviatedIRI="kt:expectedEntailment"/></Declaration>
  <Declaration><ObjectProperty abbreviatedIRI="kt:knownFailure"/></Declaration>
  <Declaration><ObjectProperty abbreviatedIRI="kt:defaultConfig"/></Declaration>
  <Declaration><ObjectProperty abbreviatedIRI="kt:resultOf"/></Declaration>
  <!-- on a test result: the suite individual the result belongs to -->
  <Declaration><ObjectProperty abbreviatedIRI="kt:suite"/></Declaration>

  <!-- ===== Data Properties ===== -->
  <Declaration><DataProperty abbreviatedIRI="kt:usesOntology"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:usesDataset"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:task"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:expectedResult"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:testClass"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:expectedFile"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:inspiredBy"/></Declaration>
  <!-- on a suite -->
  <Declaration><DataProperty abbreviatedIRI="kt:suiteName"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:suiteDirectory"/></Declaration>
  <!-- on a run configuration -->
  <Declaration><DataProperty abbreviatedIRI="kt:runConfigName"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:timeoutSeconds"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:repeatCount"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:flaky"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:verifiedResultByReasonerOnVersion"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:divergingResultByReasonerOnVersion"/></Declaration>
  <!-- on the issue -->
  <Declaration><DataProperty abbreviatedIRI="kt:tracker"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:affectsConfig"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:affectsOS"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:status"/></Declaration>
  <!-- on the test result -->
  <Declaration><DataProperty abbreviatedIRI="kt:outcome"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:runOutcome"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:underConfig"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:onOS"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:durationMs"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:reasonerVersion"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:interface"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:runConfig"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:systemConfig"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:expected"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:actual"/></Declaration>
  <Declaration><DataProperty abbreviatedIRI="kt:explanation"/></Declaration>
  <!-- absolute path of the file with the logged output of the executed Konclude run -->
  <Declaration><DataProperty abbreviatedIRI="kt:outputFile"/></Declaration>
  <!-- absolute path of the answer file written for one execution -->
  <Declaration><DataProperty abbreviatedIRI="kt:responseFile"/></Declaration>

</Ontology>
