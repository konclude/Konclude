<?xml version="1.0" encoding="UTF-8"?>
<!--
  LUBM Query9 over the ontology and the generated data file. The query itself
  contains the two LOAD commands, so no separate dataset is assigned. The
  expected file was produced by the v0.7.0-1138 static build and answers with
  the 208 students of the query.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/suite/lubm">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

  <ClassAssertion><Class abbreviatedIRI="kt:TestSuite"/><NamedIndividual abbreviatedIRI="kt:suite-lubm"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteName"/><NamedIndividual abbreviatedIRI="kt:suite-lubm"/><Literal>LUBM</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteDirectory"/><NamedIndividual abbreviatedIRI="kt:suite-lubm"/><Literal>lubm</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:lubm-query9"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:lubm-query9"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:lubm-query9"/><Literal>../../lubm-univ-bench-sparql-load-and-query-test.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:lubm-query9"/><Literal>expected/lubm-query9.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:inspiredBy"/><NamedIndividual abbreviatedIRI="kt:lubm-query9"/><Literal>LUBM Query9</Literal></DataPropertyAssertion>
</Ontology>
