  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:sparql-select-hidden-class-var"/><Literal>expected/select-hidden-class-var.xml</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-lang-select-ages"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:sparql-lang-select-ages"/><Literal>Language-features ontology: integer ages, ORDER BY DESC and LIMIT.</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-lang-select-ages"/><Literal>sparql</Literal></DataPropertyAssertion>
