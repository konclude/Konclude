  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:sparql-union"/><Literal>expected/union.xml</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><Literal>Test case: sparql-filter.</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><Literal>queries/filter.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><Literal>expected/filter.xml</Literal></DataPropertyAssertion>
  <ObjectPropertyAssertion><ObjectProperty abbreviatedIRI="kt:usesTestRunConfig"/><NamedIndividual abbreviatedIRI="kt:sparql-filter"/><NamedIndividual abbreviatedIRI="kt:run-sparql-timeout5"/></ObjectPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-filter-not-closed"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-filter-not-closed"/><Literal>Not a closed ASK: the FILTER uses ?w, so the sub-query must return bindings and Redland must apply the filter. Only alice is a Woman, so the answer is false.</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-filter-not-closed"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-filter-not-closed"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-filter-not-closed"/><Literal>queries/ask-filter-not-closed.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedResult"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-filter-not-closed"/><Literal>false</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:sparql-select-hidden-class-var"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:sparql-select-hidden-class-var"/><Literal>Hidden class variable: ?c is never existential and must be answered from named classes, not replaced by a placeholder. DISTINCT returns the two individuals.</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-select-hidden-class-var"/><Literal>sparql</Literal></DataPropertyAssertion>
