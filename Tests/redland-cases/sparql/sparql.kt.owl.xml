  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:description"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-optional"/><Literal>Not a closed ASK: OPTIONAL keeps it on the regular Redland path; the answer is true.</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-optional"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:sparql-ask-optional"/><Literal>family.owl.xml</Literal></DataPropertyAssertion>
