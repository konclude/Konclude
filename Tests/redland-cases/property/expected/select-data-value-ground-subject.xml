<?xml version="1.0" encoding="UTF-8"?>
<!-- Expected answer for select-data-value-ground-subject.sparql:
     :a asserts :dp1 "v1" and :dpSub "v1sub", and :dpSub is a sub-property of :dp1,
     so both values are values of the known subject. Rows are compared as a set. -->
<sparql xmlns="http://www.w3.org/2005/sparql-results#">
  <head>
    <variable name="val"/>
  </head>
  <results>
    <result>
      <binding name="val"><literal datatype="http://www.w3.org/2001/XMLSchema#string">v1</literal></binding>
    </result>
    <result>
      <binding name="val"><literal datatype="http://www.w3.org/2001/XMLSchema#string">v1sub</literal></binding>
    </result>
  </results>
</sparql>
