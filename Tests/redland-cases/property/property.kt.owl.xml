  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:property-object-value-propagation"/><Literal>expected/object-value-propagation.xml</Literal></DataPropertyAssertion>

