<?xml version="1.0" encoding="UTF-8"?>
<!--
  Property queries of the SPARQL interface: the object-property and class
  hierarchy queries, the propagation of object-property and data-property
  values to super-properties, inverse properties and the negative control that
  a data-property hierarchy query does not return object properties.

  The last group covers shapes that are known to be broken today (crashes,
  hangs or missing answers, see Tests/known-issues.owl.xml): the string-typed
  literal does not match the plain literal, declarations are not answered as
  schema triples, a variable predicate crashes the answering, and a ground
  data-property value query does not terminate. Those tests are marked with
  kt:knownFailure and become KNOWN; they flip to FIXED as soon as a fix makes
  them pass.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/suite/property">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

  <!-- Suite: the folder containing this control ontology. -->
  <ClassAssertion><Class abbreviatedIRI="kt:TestSuite"/><NamedIndividual abbreviatedIRI="kt:suite-property"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteName"/><NamedIndividual abbreviatedIRI="kt:suite-property"/><Literal>Property</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteDirectory"/><NamedIndividual abbreviatedIRI="kt:suite-property"/><Literal>property</Literal></DataPropertyAssertion>

  <!-- Object property hierarchy, the control of the data-property crash of issue #26. -->
  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:property-object-super-hierarchy"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:property-object-super-hierarchy"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:property-object-super-hierarchy"/><Literal>property.ttl</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:property-object-super-hierarchy"/><Literal>queries/object-super-hierarchy.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:property-object-super-hierarchy"/><Literal>expected/object-super-hierarchy.xml</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:SparqlTest"/><NamedIndividual abbreviatedIRI="kt:property-object-sub-hierarchy"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:property-object-sub-hierarchy"/><Literal>sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesDataset"/><NamedIndividual abbreviatedIRI="kt:property-object-sub-hierarchy"/><Literal>property.ttl</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:property-object-sub-hierarchy"/><Literal>queries/object-sub-hierarchy.sparql</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:property-object-sub-hierarchy"/><Literal>expected/object-sub-hierarchy.xml</Literal></DataPropertyAssertion>

