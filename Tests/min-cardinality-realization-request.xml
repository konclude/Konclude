<?xml version="1.0" encoding="UTF-8"?>

<!--
	Shows that the entailment check and the instance retrieval disagree for classes
	that are defined by a qualified minimum cardinality restriction, see the comment
	in Tests/min-cardinality-realization.owl.xml.

	IsInstanceOf correctly answers true for p, but GetFlattenedInstances returns an
	empty set instead of {p}. Both answers are produced within the same run and for
	the same knowledge base.

	Use the configuration file Configs/no-upfront-instance-merging-config.xml to obtain
	the expected answers:

	  ./Konclude owllinkfile -c Configs/no-upfront-instance-merging-config.xml \
	      -i Tests/min-cardinality-realization-request.xml
-->

<RequestMessage xmlns="http://www.owllink.org/owllink#"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xsi:schemaLocation="http://www.owllink.org/owllink# http://www.owllink.org/owllink-20091116.xsd">

	<CreateKB kb="http://te.st/min-cardinality-realization"/>

	<LoadOntologies kb="http://te.st/min-cardinality-realization">
		<OntologyIRI IRI="file:./Tests/min-cardinality-realization.owl.xml"/>
	</LoadOntologies>

	<!-- answered correctly with true -->
	<IsInstanceOf kb="http://te.st/min-cardinality-realization" direct="false">
		<owl:NamedIndividual IRI="http://konclude.com/test/min-cardinality-realization#p"/>
		<owl:Class IRI="http://konclude.com/test/min-cardinality-realization#ManySibling"/>
	</IsInstanceOf>

	<!-- should return p, but the returned set of individuals is empty -->
	<GetFlattenedInstances kb="http://te.st/min-cardinality-realization" direct="false">
		<owl:Class IRI="http://konclude.com/test/min-cardinality-realization#ManySibling"/>
	</GetFlattenedInstances>

	<ReleaseKB kb="http://te.st/min-cardinality-realization"/>

</RequestMessage>
