<?xml version="1.0" encoding="UTF-8"?>
<!--
  known-issues.owl.xml - the known-divergence model shared by all suites.

  An issue is a first-class individual. Its type records whether it is a
  reasoner bug, an unsupported feature, a performance issue or a corpus
  limitation. kt:affectsTest links the issue to every affected test; the
  same issue can therefore be referenced by many tests. A test links back
  with kt:knownFailure (see the *.kt.owl.xml control ontologies).

  The file is not discovered as a test (it is not *.kt.owl.xml and lives
  outside Tests/cases/).
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/known-issues">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

